<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical"
    android:padding="10dp" android:background="@drawable/widget_panel_light">
    <LinearLayout android:id="@+id/widget_header"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="24dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/prayer_widget_label" android:textColor="#173D31"
            android:textSize="15sp" android:textStyle="bold" android:fontFamily="sans-serif-rounded"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_date"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Qada Tracker" android:textColor="#4C7163" android:textSize="11sp"
            android:maxLines="1" android:layout_marginStart="6dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:baselineAligned="false" android:layout_marginTop="4dp">
        <LinearLayout android:id="@+id/widget_subuh" style="@style/PrayerWidgetBox">
            <TextView android:id="@+id/widget_subuh_name" style="@style/PrayerWidgetName" android:text="Subuh" />
            <TextView android:id="@+id/widget_subuh_status" style="@style/PrayerWidgetStatus" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_zohor" style="@style/PrayerWidgetBox">
            <TextView android:id="@+id/widget_zohor_name" style="@style/PrayerWidgetName" android:text="Zohor" />
            <TextView android:id="@+id/widget_zohor_status" style="@style/PrayerWidgetStatus" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_asar" style="@style/PrayerWidgetBox">
            <TextView android:id="@+id/widget_asar_name" style="@style/PrayerWidgetName" android:text="Asar" />
            <TextView android:id="@+id/widget_asar_status" style="@style/PrayerWidgetStatus" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_maghrib" style="@style/PrayerWidgetBox">
            <TextView android:id="@+id/widget_maghrib_name" style="@style/PrayerWidgetName" android:text="Maghrib" />
            <TextView android:id="@+id/widget_maghrib_status" style="@style/PrayerWidgetStatus" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_isyak" style="@style/PrayerWidgetBox">
            <TextView android:id="@+id/widget_isyak_name" style="@style/PrayerWidgetName" android:text="Isyak" />
            <TextView android:id="@+id/widget_isyak_status" style="@style/PrayerWidgetStatus" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_footer"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:minHeight="20dp" android:gravity="center_vertical"
        android:text="Tap a box to record today’s prayer" android:textColor="#4C7163"
        android:textSize="11sp" android:maxLines="2" />
</LinearLayout>
